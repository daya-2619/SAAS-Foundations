# Docker-Compose sample .env file for LogCenter
DJANGO_DEBUG=1
DJANGO_SECRET_KEY="super-secret-key-change-in-production"

# In Docker, these are typically overridden in docker-compose.yml, but set them here for clarity
DATABASE_URL="postgres://postgres:postgrespassword@db:5432/logcenter"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"
REDIS_URL="redis://redis:6379/0"

# Email Configuration (For anomaly alerts)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
ADMIN_USER_EMAIL=""

# Payments (If enabled)
STRIPE_SECRET_KEY=""